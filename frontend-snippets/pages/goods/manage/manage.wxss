/* ============================================================
 * pages/goods/manage/manage.wxss
 * 「我的商品」卖家管理 —— iOS 风行式卡片
 * 视觉目标：doc/mockups/figure/07_goods_manage_v1.png
 * 严格使用 var(--xxx) + rpx，禁止写死 hex / px
 * ============================================================ */

.page {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: calc(var(--spacing-xxl) + env(safe-area-inset-bottom));
}

/* ============================================================
 * Tabs —— 顶部 4 段
 * ============================================================ */
.tabs-wrap {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--color-bg-card);
  box-shadow: 0 1rpx 0 var(--color-border-light);
}

.tabs-wrap .van-tab {
  font-size: var(--font-size-md) !important;
  font-weight: 500;
}

.tabs-wrap .van-tabs__line {
  border-radius: var(--radius-pill);
}

/* ============================================================
 * 主体
 * ============================================================ */
.body {
  padding: var(--spacing-lg) var(--spacing-page) 0;
  display: flex;
  flex-direction: column;
  gap: var(--spacing-lg);
}

.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-card);
}

/* ============================================================
 * 列表项 —— 横向卡片
 *   左：缩略图 / 中：信息 / 右：操作堆
 * ============================================================ */
.item {
  display: flex;
  align-items: stretch;
  padding: var(--spacing-lg);
  gap: var(--spacing-lg);
  transition: transform 120ms ease-out, background-color 120ms ease-out;
}

.item--hover {
  transform: scale(0.992);
  background: var(--color-bg-fill-light);
}

/* ---------- 缩略图 ---------- */
.item__cover {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--color-bg-fill-light);
}

.item__img {
  width: 100%;
  height: 100%;
  display: block;
}

.item__badge {
  position: absolute;
  left: 0;
  bottom: 0;
  right: 0;
  padding: 6rpx 0;
  text-align: center;
  font-size: var(--font-size-xs);
  color: var(--color-text-inverse);
  letter-spacing: 1rpx;
  backdrop-filter: blur(8rpx);
}

.item__badge--sold {
  background: rgba(26, 173, 25, 0.85);
}

.item__badge--off {
  background: rgba(102, 102, 102, 0.78);
}

.item__badge--draft {
  background: rgba(255, 151, 106, 0.92);
}

/* ---------- 中部信息 ---------- */
.item__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 4rpx 0;
}

.item__title {
  font-size: var(--font-size-md);
  font-weight: 500;
  color: var(--color-text-primary);
  line-height: 1.4;
}

.item__price {
  font-family: "DIN Alternate", -apple-system, sans-serif;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-danger);
  line-height: 1;
  margin-top: var(--spacing-sm);
}

.item__price::before {
  content: "¥";
  font-size: 0.6em;
  font-weight: 600;
  margin-right: 2rpx;
}

.item__stats {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  margin-top: var(--spacing-sm);
}

.item__stat-sep {
  opacity: 0.6;
}

/* ---------- 右侧操作堆 ---------- */
.item__actions {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: stretch;
  gap: var(--spacing-md);
  flex-shrink: 0;
  width: 140rpx;
}

.act-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 var(--spacing-md);
  border-radius: var(--radius-md);
  font-size: var(--font-size-sm);
  font-weight: 500;
  line-height: 1;
  text-align: center;
  transition: opacity 120ms ease-out, background-color 120ms ease-out, transform 120ms ease-out;
}

.act-btn--hover {
  transform: scale(0.96);
  opacity: 0.85;
}

/* 主操作（绿色实心） */
.act-btn--primary {
  background: var(--color-primary);
  color: var(--color-text-inverse);
  box-shadow: 0 4rpx 12rpx rgba(26, 173, 25, 0.22);
}

/* 次操作（绿色描边） */
.act-btn--ghost {
  background: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}

/* 危险操作（红色描边） */
.act-btn--ghost-danger {
  background: transparent;
  color: var(--color-danger);
  border: 2rpx solid var(--color-danger);
}

/* ============================================================
 * 骨架屏
 * ============================================================ */
.skeleton-card {
  display: flex;
  align-items: stretch;
  padding: var(--spacing-lg);
  gap: var(--spacing-lg);
}

.skeleton {
  background: linear-gradient(
    90deg,
    var(--color-bg-fill-medium) 0%,
    var(--color-bg-fill-light) 50%,
    var(--color-bg-fill-medium) 100%
  );
  background-size: 300% 100%;
  animation: skeleton-shimmer 1.4s ease-in-out infinite;
  border-radius: var(--radius-md);
}

.skeleton-cover {
  width: 180rpx;
  height: 180rpx;
  border-radius: var(--radius-lg);
  flex-shrink: 0;
}

.skeleton-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 8rpx 0;
}

.skeleton-line {
  height: 28rpx;
  border-radius: var(--radius-sm);
}

.skeleton-line--lg {
  width: 80%;
}

.skeleton-line--md {
  width: 40%;
  height: 36rpx;
}

.skeleton-line--sm {
  width: 50%;
  height: 22rpx;
}

@keyframes skeleton-shimmer {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}

/* ============================================================
 * 底部占位
 * ============================================================ */
.footer-spacer {
  height: var(--spacing-xxl);
}

/* ============================================================
 * 文本工具（局部，避免依赖 app.wxss 改动）
 * ============================================================ */
.text-ellipsis-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
