/* P02_password — 修改密码
   视觉目标：doc/mockups/figure/02_password_v1.png
   严格 token 化：禁止任何 hex / px（rpx 与 0/100% 例外） */

.pwd-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg-page);
  padding: var(--spacing-xl) var(--spacing-page) 0;
  box-sizing: border-box;
}

/* ---------- 表单卡片 ---------- */
.pwd-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

/* van-cell-group 自带的灰色背景去掉，由 .pwd-card 承担圆角 */
.pwd-cell-group {
  background: transparent !important;
}

/* van-field 内部通过 custom-class 注入 — 微调字号、留白 */
.pwd-field {
  background: var(--color-bg-card) !important;
  padding: var(--spacing-lg) var(--spacing-xl) !important;
}

.pwd-field-label {
  color: var(--color-text-primary) !important;
  font-size: var(--font-size-md) !important;
  font-weight: 500 !important;
  width: 7em !important;
  min-width: 6em !important;
}

.pwd-field-input {
  color: var(--color-text-primary) !important;
  font-size: var(--font-size-md) !important;
  /* 密码圆点字符在某些字体下偏小，这里轻微提升 letter-spacing 让原点更均匀 */
  letter-spacing: 2rpx;
}

.pwd-field-placeholder {
  color: var(--color-text-disabled) !important;
  font-size: var(--font-size-md) !important;
}

.pwd-field-last {
  /* 最后一行不画下边线（由 border={{false}} 控制，这里兜底确保视觉对齐） */
  border-bottom: 0 !important;
}

/* ---------- 规则提示 ---------- */
.pwd-hint {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-top: var(--spacing-lg);
  padding: 0 var(--spacing-md);
  color: var(--color-text-tertiary);
  font-size: var(--font-size-sm);
  line-height: 1.5;
  transition: color 200ms cubic-bezier(0, 0, 0.2, 1);
}

.pwd-hint-icon {
  color: var(--color-text-tertiary);
}

.pwd-hint-text {
  flex: 1;
}

/* 规则达标时整体转绿 */
.pwd-hint-ok {
  color: var(--color-primary);
}

.pwd-hint-ok .pwd-hint-icon {
  color: var(--color-primary);
}

/* ---------- 不匹配警告 ---------- */
.pwd-warn {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-top: var(--spacing-md);
  padding: var(--spacing-sm) var(--spacing-md);
  background: rgba(238, 10, 36, 0.06);
  color: var(--color-danger);
  border-radius: var(--radius-md);
  font-size: var(--font-size-sm);
  line-height: 1.5;
}

.pwd-warn-icon {
  color: var(--color-danger);
}

/* ---------- 中部弹性留白 ---------- */
.pwd-spacer {
  flex: 1;
  min-height: var(--spacing-xxl);
}

/* ---------- 吸底保存按钮 ---------- */
.pwd-submit {
  position: sticky;
  bottom: 0;
  padding: var(--spacing-lg) 0 calc(var(--spacing-xl) + env(safe-area-inset-bottom));
  background: var(--color-bg-page);
}

/* van-button 通过 custom-class 注入 */
.pwd-submit-btn {
  height: 96rpx !important;
  font-size: var(--font-size-lg) !important;
  font-weight: 600 !important;
  letter-spacing: 4rpx;
}
