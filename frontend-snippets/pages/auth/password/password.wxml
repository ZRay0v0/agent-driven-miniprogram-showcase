<!-- P02_password — 修改密码
     视觉目标：doc/mockups/figure/02_password_v1.png
     纯 Vant + design tokens；不含写死 hex / px
     结构：白底卡（三 van-field 密码输入） → 规则提示 → 吸底保存按钮 -->
<view class="pwd-page">

  <!-- 表单卡片：三行密码 -->
  <view class="pwd-card">
    <van-cell-group border="{{ false }}" custom-class="pwd-cell-group">

      <!-- 当前密码 -->
      <van-field
        label="当前密码"
        value="{{ oldPwd }}"
        type="{{ showOld ? 'text' : 'password' }}"
        placeholder="请输入当前密码"
        placeholder-class="pwd-field-placeholder"
        border="{{ true }}"
        clearable="{{ false }}"
        maxlength="32"
        custom-class="pwd-field"
        label-class="pwd-field-label"
        input-class="pwd-field-input"
        right-icon="{{ showOld ? 'eye-o' : 'closed-eye' }}"
        data-target="showOld"
        bind:change="onOldInput"
        bind:click-icon="onToggleVisible"
      />

      <!-- 新密码 -->
      <van-field
        label="新密码"
        value="{{ newPwd }}"
        type="{{ showNew ? 'text' : 'password' }}"
        placeholder="请输入新密码"
        placeholder-class="pwd-field-placeholder"
        border="{{ true }}"
        clearable="{{ false }}"
        maxlength="32"
        custom-class="pwd-field"
        label-class="pwd-field-label"
        input-class="pwd-field-input"
        right-icon="{{ showNew ? 'eye-o' : 'closed-eye' }}"
        data-target="showNew"
        bind:change="onNewInput"
        bind:click-icon="onToggleVisible"
      />

      <!-- 确认新密码 -->
      <van-field
        label="确认新密码"
        value="{{ confirmPwd }}"
        type="{{ showConfirm ? 'text' : 'password' }}"
        placeholder="请再次输入新密码"
        placeholder-class="pwd-field-placeholder"
        border="{{ false }}"
        clearable="{{ false }}"
        maxlength="32"
        custom-class="pwd-field pwd-field-last"
        label-class="pwd-field-label"
        input-class="pwd-field-input"
        right-icon="{{ showConfirm ? 'eye-o' : 'closed-eye' }}"
        data-target="showConfirm"
        bind:change="onConfirmInput"
        bind:click-icon="onToggleVisible"
      />

    </van-cell-group>
  </view>

  <!-- 规则提示 — 根据规则达标动态变色 -->
  <view class="pwd-hint {{ ruleOk ? 'pwd-hint-ok' : '' }}">
    <van-icon
      name="{{ ruleOk ? 'checked' : 'info-o' }}"
      size="24rpx"
      custom-class="pwd-hint-icon"
    />
    <text class="pwd-hint-text">至少 8 位，含字母和数字</text>
  </view>

  <!-- 确认不匹配提示（仅当用户已输入确认密码且不匹配时显示） -->
  <view wx:if="{{ confirmPwd && !confirmOk }}" class="pwd-warn">
    <van-icon name="warning-o" size="24rpx" custom-class="pwd-warn-icon" />
    <text>两次输入的新密码不一致</text>
  </view>

  <!-- 撑开中部留白，把保存按钮顶到底部 -->
  <view class="pwd-spacer"></view>

  <!-- 吸底保存按钮 -->
  <view class="pwd-submit">
    <van-button
      type="primary"
      block
      round
      loading="{{ loading }}"
      loading-text="保存中..."
      disabled="{{ !canSubmit }}"
      custom-class="pwd-submit-btn"
      bind:click="onSubmit"
    >
      保存
    </van-button>
  </view>

  <van-toast id="van-toast" />
</view>
